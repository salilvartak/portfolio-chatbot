# Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Firebase Admin service account (Firebase Console > Project settings > Service accounts >
# Generate new private key). Paste the whole JSON on ONE line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Comma-separated origins allowed to call the API (your portfolio domain + local dev)
ALLOWED_ORIGINS=http://localhost:5173
# Your portfolio's public URL, used to link blog posts in citations
SITE_URL=

RATE_LIMIT=20/minute
