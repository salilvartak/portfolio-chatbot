# Gemini API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# Firebase Admin service account (Firebase Console > Project settings > Service accounts >
# Generate new private key). Paste the whole JSON on ONE line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Comma-separated origins allowed to call the API (your portfolio domain + local dev)
ALLOWED_ORIGINS=http://localhost:5173
# Your portfolio's public URL, used to link blog posts in citations
SITE_URL=

RATE_LIMIT=20/minute
# Email the bot points visitors to when it can't answer
CONTACT_EMAIL=

# Secret for POST /admin/reindex (Render generates one automatically)
ADMIN_TOKEN=
# Model reasoning before answering: minimal / low / medium / high
THINKING_LEVEL=low
# Models to try in order if CHAT_MODEL is overloaded (comma-separated)
FALLBACK_MODELS=

# ── Call booking (Google Calendar). Disabled until all three OAuth values are set. See README.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional overrides
# BOOKING_HOURS=mon-fri 19:00-24:00; sat-sun 10:00-14:00, 19:00-24:00
# OWNER_TIMEZONE=Asia/Kolkata
# SLOT_MINUTES=30
# BUFFER_MINUTES=15
# MIN_NOTICE_HOURS=12
# BOOKING_DAYS_AHEAD=14
# MAX_BOOKINGS_PER_DAY=3
# NOTIFY_EMAIL=          # who gets new-request emails (defaults to CONTACT_EMAIL)
